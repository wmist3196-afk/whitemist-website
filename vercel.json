{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/product/:slug", "destination": "/product.html" },
    { "source": "/shop/:category", "destination": "/shop.html" }
  ],
  "headers": [
    { "source": "/(css|js)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }] }
  ]
}
